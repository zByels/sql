## WHERE

### Operador Like

Vamos selecionar todos que começam com a letra `p`
-- SQLBook: Code
SELECT *
FROM tb_aluno
WHERE nome LIKE 'p%';
-- SQLBook: Code
CREATE TABLE usuario (
  id INT PRIMARY KEY AUTO_INCREMENT,
  nome VARCHAR(255),
  data_criacao DATETIME DEFAULT CURRENT_TIMESTAMP
);

TRUNCATE usuario;

INSERT INTO usuario(nome) VALUES ('Caio');

INSERT INTO usuario(nome) VALUES ('Outro');

-- SQLBook: Code
SELECT * FROM usuario;
-- SQLBook: Markup
|id|nome|data_criacao|
|--|----|------------|
|1|Caio|2025-03-17 23:52:47|
|2|Outro|2025-03-17 23:52:50
-- SQLBook: Code
INSERT INTO usuario(nome) VALUES ('Caio');

INSERT INTO usuario(nome) VALUES ('Outro');
SELECT * FROM usuario;
-- SQLBook: Markup
|id|nome|data_criacao|
|--|----|------------|
|1|Caio|2025-03-17 23:52:47|
|2|Outro|2025-03-17 23:52:50|
|3|Caio|2025-03-17 23:53:39|
|4|Outro|2025-03-17 23:53:40
-- SQLBook: Code
TRUNCATE usuario;
INSERT INTO usuario(id, nome) VALUES 
(1, 'Caio'), 
(2, 'Outro');

INSERT INTO usuario(id, nome) VALUES 
(1, 'Caio'), 
(2, 'Outro');
-- SQLBook: Markup
# Chave Estrangeira (FK): restrição para apagar!
-- SQLBook: Code
DROP TABLE IF EXISTS usuario;

CREATE TABLE usuario (
    id_usuario BIGINT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(255) NOT NULL,
    data_cadastro DATETIME DEFAULT CURRENT_TIMESTAMP
);

INSERT INTO usuario
VALUES
    (1, 'Superman', '2025-01-15'),
    (2, 'Batman', '2025-02-16'),
    (3, 'Mulher-maravilha', '2025-03-17'),
    (4, 'Flash', '2025-03-17');

SELECT * FROM usuario;
-- SQLBook: Markup
|id_usuario|nome|data_cadastro|
|----------|----|-------------|
|1|Superman|2025-01-15 00:00:00|
|2|Batman|2025-02-16 00:00:00|
|3|Mulher-maravilha|2025-03-17 00:00:00|
|4|Flash|2025-03-17 00:00:00
-- SQLBook: Code
DROP TABLE IF EXISTS post;
CREATE TABLE post (
    id_post INTEGER PRIMARY KEY AUTO_INCREMENT,
    id_usuario  BIGINT REFERENCES usuario (id_usuario),
    conteudo TEXT NOT NULL,
    data_publicacao DATETIME DEFAULT CURRENT_TIMESTAMP
);

INSERT INTO post 
VALUES
    (1, 2, 'Gotham nunca dorme.', '2025-03-01'),
    (2, 3, 'A força da verdade é imbatível.', '2025-03-17'),
    (3, 4, 'A velocidade é tudo!', '2025-03-18');

SELECT * FROM post;
-- SQLBook: Markup
|id_post|id_usuario|conteudo|data_publicacao|
|-------|----------|--------|---------------|
|1|2|Gotham nunca dorme.|2025-03-01 00:00:00|
|2|3|A força da verdade é imbatível.|2025-03-17 00:00:00|
|3|4|A velocidade é tudo!|2025-03-18 00:00:00
-- SQLBook: Code
# DELETE FROM post WHERE id_usuario = 2;
# DELETE FROM usuario WHERE id_usuario = 2;
-- SQLBook: Code
DROP TABLE IF EXISTS post;
CREATE TABLE post (
    id_post INTEGER PRIMARY KEY AUTO_INCREMENT,
    id_usuario  BIGINT REFERENCES usuario (id_usuario) ON DELETE CASCADE,
    conteudo TEXT NOT NULL,
    data_publicacao DATETIME DEFAULT CURRENT_TIMESTAMP
);

INSERT INTO post 
VALUES
    (1, 2, 'Gotham nunca dorme.', '2025-03-01'),
    (2, 3, 'A força da verdade é imbatível.', '2025-03-17'),
    (3, 4, 'A velocidade é tudo!', '2025-03-18');

SELECT * FROM post;


START TRANSACTION;
DELETE FROM usuario WHERE id_usuario = 2;
SELECT * FROM usuario;
SELECT * FROM post;
ROLLBACK;
