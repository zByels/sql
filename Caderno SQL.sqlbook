# Escrevendo código `SQL`
-- SQLBook: Code
CREATE DATABASE aula06;

USE aula06;
-- SQLBook: Code
CREATE TABLE tb_aluno (
    id_aluno INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    telefone VARCHAR(20) NOT NULL
);
-- SQLBook: Code
INSERT INTO tb_aluno 
 VALUES 
    (1, 'João', '271897483'),
    (2, 'Maria', '271897484'),
    (3, 'José', '271897485'),
    (4, 'Pedro', '271897486'),
    (5, 'Ana', '271897487'),
    (6, 'Marcos', '271897488'),
    (7, 'Paulo', '271897489'),
    (8, 'Carla', '271897490'),
    (9, 'Joana', '271897491'),
    (10, 'Rafael', '271897492');
-- SQLBook: Code
SELECT * FROM tb_aluno;
