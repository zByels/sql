-- SQLBook: Markup
Ver os preços cobrados pela locação
-- SQLBook: Code
SELECT 
    AVG(rental_rate) AS average_rental_rate,
    MIN(rental_rate) AS minimum_rental_rate,
    MAX(rental_rate) AS maximum_rental_rate,
    SUM(rental_rate) AS total_rental_rate
FROM 
    film;
-- SQLBook: Markup
|average_rental_rate|minimum_rental_rate|maximum_rental_rate|total_rental_rate|
|-------------------|-------------------|-------------------|-----------------|
|2.98|0.99|4.99|2980
-- SQLBook: Markup
